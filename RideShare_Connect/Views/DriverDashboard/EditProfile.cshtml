@model RideShare_Connect.ViewModels.EditDriverViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<h2>Edit Profile</h2>

<form asp-action="EditProfile" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="DriverId" />
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LicenseNumber" class="form-label"></label>
        <input asp-for="LicenseNumber" class="form-control" />
        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Profile Picture</label><br />
        @if (!string.IsNullOrEmpty(Model.ExistingProfilePicture))
        {
            <img src="@Model.ExistingProfilePicture" alt="Profile Picture" class="img-thumbnail mb-2" style="max-width:150px;" />
        }
        <input asp-for="ProfilePicture" type="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DrivingExperienceYears" class="form-label"></label>
        <input asp-for="DrivingExperienceYears" class="form-control" />
        <span asp-validation-for="DrivingExperienceYears" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DOB" class="form-label"></label>
        <input asp-for="DOB" class="form-control" type="date" />
        <span asp-validation-for="DOB" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Driver" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

