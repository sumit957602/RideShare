@{
    ViewData["Title"] = "Add Payment Method";
}

<div class="container mt-5">
    <h2 class="mb-4">Add Payment Method</h2>
    <div class="modal-body p-0">
        <p class="text-muted small">Your payment information is securely handled by our PCI-compliant payment partner.</p>
        <form>
            <div class="mb-3">
                <label for="cardName" class="form-label">Name on Card</label>
                <input type="text" class="form-control" id="cardName" placeholder="John Doe">
            </div>
            <div class="mb-3">
                <label for="cardNumber" class="form-label">Card Number</label>
                <div id="card-element" class="form-control">
                    <!-- A Stripe/Razorpay Element will be inserted here -->
                    <span class="text-muted">•••• •••• •••• ••••</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="cardExpiry" class="form-label">Expiry</label>
                    <div id="card-expiry-element" class="form-control"><span class="text-muted">MM / YY</span></div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="cardCvc" class="form-label">CVC</label>
                    <div id="card-cvc-element" class="form-control"><span class="text-muted">•••</span></div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save Method</button>
            <a asp-action="Finance" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
